{
  "name": "biscuit-paws",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tiles": "tsx scripts/build-tiles.ts",
    "art": "tsx scripts/build-worn-tiles.ts",
    "art:kitchen": "tsx scripts/art/kitchen.ts",
    "art:placeholders": "tsx scripts/art/placeholders.ts",
    "art:cafe": "tsx scripts/art/cafe.ts && tsx scripts/build-worn-tiles.ts",
    "character": "tsx scripts/import-character.ts",
    "backyard": "tsx scripts/import-backyard.ts",
    "seasons": "tsx scripts/import-seasons.ts",
    "ui-audio": "tsx scripts/import-ui-audio.ts",
    "predev": "npm run tiles && npm run art && npm run art:placeholders",
    "dev": "vite",
    "prebuild": "npm run check && npm run art",
    "build": "vite build",
    "check": "npm run tiles && tsc --noEmit && tsx scripts/check-data.ts",
    "pretest": "npm run tiles",
    "test": "vitest run",
    "test:e2e": "npm run tiles && playwright test",
    "vet": "tsx scripts/import-vet.ts",
    "pixellab": "tsx scripts/import-pixellab.ts",
    "mannequin": "tsx scripts/import-mannequin.ts",
    "npcs": "tsx scripts/import-npcs.ts",
    "minigames": "tsx scripts/import-minigames.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
