      "exclusive": true,
      "goal": {
        "title": "Uma cafeteira",
        "steps": [
          {
            "text": "Juntar 205 moedas com pedidos da vila (mural do mercado ou celular, tecla P): a cafeteira (180) e um balcão para ela (25).",
            "when": {
              "any": [
                {
                  "money": {
                    "gte": 205
                  }
                },
                {
                  "all": [
                    {
                      "owned": "item.coffee_machine"
                    },
                    {
                      "ownedTag": "bar"
                    }
                  ]
                }
              ]
            }
          },
          {
            "text": "Encomendar um balcão pelo Market (C).",
            "when": {
              "ownedTag": "bar"
            }
          },
          {
            "text": "Encomendar a cafeteira pelo Market (C).",
            "when": {
              "owned": "item.coffee_machine"
            }
          },
          {
            "text": "Montar o balcão e pôr a cafeteira em cima dele.",
            "when": {
              "placed": "item.coffee_machine"
            },
            "devNote": "Abrir as caixas no salão; a cafeteira só vai em cima de um balcão livre (placeOn: bar)."
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.coffee_ready"
        }
      ]
