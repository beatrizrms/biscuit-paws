        {
          "makeSick": "cat.first_stray"
        },
        {
          "setFlag": "clinic.open"
        },
        {
          "dialogue": "dlg.cat_sick"
        }
      ]
    },
    {
      "id": "story.vet_visit",
      "act": 1,
      "after": [
        "story.cat_falls_ill"
      ],
      "exclusive": true,
      "goal": {
        "title": "Gatinho doente",
        "steps": [
          {
            "text": "Ver se a obra no fim da rua já virou a clínica veterinária.",
            "when": {
              "any": [
                {
                  "flag": "seen.scr.clinic_opening"
                },
                {
                  "flag": "vet.consulted"
                },
                {
                  "flag": "vet.intake_done"
                }
              ]
            },
            "devNote": "Andar até a porta da clínica (rua): o intercept da porta roda scr.clinic_opening, que leva para dentro. Já ter consultado também conta (save de antes da cena de inauguração)."
          },
          {
            "text": "Buscar {cat:cat.first_stray} no café e levar no colo até a clínica da Fernanda.",
            "when": {
              "any": [
                {
                  "flag": "vet.consulted"
                },
                {
                  "flag": "vet.intake_done"
                }
              ]
            },
            "devNote": "E perto do gato pega no colo; na clínica, E no balcão da Fernanda abre a consulta. A consulta de entrada (vet.intake_done) também conta: com o gato doente, ela já começa o tratamento."
          },
          {
            "text": "Dar o remédio para {cat:cat.first_stray}",
            "detail": "Uma dose por dia, até acabar a receita.",
            "icon": "remedio",
            "doses": "cat.first_stray",
            "when": {
              "flag": "vet.cured"
            },
            "devNote": "Remédio ativo na barra e E perto do gato (uma dose por dia)."
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.vet_cured"
        }
      ]
    },
    {
      "id": "story.litter_surprise",
      "act": 1,
      "after": [
        "story.prologue_end"
