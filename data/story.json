{
  "schemaVersion": 1,
  "beats": [
    {
      "id": "story.intro",
      "act": 1,
      "effects": [
        {
          "dialogue": "dlg.intro"
        },
        {
          "setFlag": "bought.old_bakery"
        }
      ]
    },
    {
      "id": "story.enter_bakery",
      "act": 1,
      "after": [
        "story.intro"
      ],
      "goal": {
        "title": "A velha padaria",
        "steps": [
          {
            "text": "Preciso ver como está lá dentro.",
            "when": {
              "visited": "map.cafe_main"
            },
            "devNote": "Porta do café: coluna 17 da rua, andar para cima."
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.inside"
        }
      ]
    },
    {
      "id": "story.cleanup",
      "act": 1,
      "after": [
        "story.enter_bakery"
      ],
      "goal": {
        "title": "Uma boa faxina",
        "steps": [
          {
            "text": "Tirar essas teias dos cantos.",
            "when": {
              "cleaned": "web"
            },
            "devNote": "Clique na sujeira, com a personagem a até 2 células."
          },
          {
            "text": "Varrer a poeira, os papéis e os cacos.",
            "when": {
              "cleaned": "floor"
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.cleaned"
        }
      ]
    },
    {
      "id": "story.warm_corner",
      "act": 1,
      "after": [
        "story.cleanup"
      ],
      "goal": {
        "title": "Um cantinho quente",
        "steps": [
          {
            "text": "Preciso de uma caminha macia...",
            "when": {
              "placed": "item.cat_bed"
            }
          },
          {
            "text": "...uma tigela de água...",
            "when": {
              "placed": "item.water_bowl"
            }
          },
          {
            "text": "...e ração, claro.",
            "when": {
              "placed": "item.food_bowl"
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.warm_corner_done"
        }
      ]
    },
    {
      "id": "story.first_seats",
      "act": 1,
      "after": [
        "story.warm_corner"
      ],
      "goal": {
        "title": "Um lugar para sentar",
        "steps": [
          {
            "text": "Uma mesa, para começar.",
            "when": {
              "placedTag": "table"
            }
          },
          {
            "text": "Duas cadeiras. Uma para cada xícara.",
            "when": {
              "placedTag": "chair",
              "gte": 2
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.neighbor_visit"
        },
        {
          "setFlag": "met.old_neighbor"
        },
        {
          "setFlag": "painter.available"
        },
        {
          "addMoney": 50
        }
      ]
    },
    {
      "id": "story.meow_outside",
      "act": 1,
      "after": [
        "story.first_seats"
      ],
      "goal": {
        "title": "Esse miado...",
        "steps": [
          {
            "text": "Quem está miando lá fora?",
            "when": {
              "flag": "cat.first_found"
            },
            "devNote": "Continua no Marco 1 (gatos): a flag cat.first_found ainda não existe."
          }
        ]
      },
      "effects": []
    }
  ]
}
