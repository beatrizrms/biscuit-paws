    {
      "id": "story.cat_falls_ill",
      "act": 1,
      "after": [
        "story.prologue_end"
      ],
      "exclusive": true,
      "start": {
        "all": [
          {
            "day": {
              "gte": 6
            }
          },
          {
            "location": "map.cafe_main"
          }
        ]
