{
  "schemaVersion": 1,
  "beats": [
    {
      "id": "story.prologue_thoughts",
      "act": 0,
      "effects": [
        {
          "cutscene": "cs.prologue_thoughts"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.intro",
      "act": 0,
      "effects": [
        {
          "setTime": "08:00"
        },
        {
          "dialogue": "dlg.intro"
        }
      ],
      "after": [
        "story.prologue_thoughts"
      ],
      "when": {
        "flag": "seen.cs.prologue_thoughts"
      },
      "exclusive": true
    },
    {
      "id": "story.realtor_tour",
      "act": 0,
      "after": [
        "story.intro"
      ],
      "effects": [
        {
          "script": "scr.realtor_tour"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.enter_bakery",
      "act": 1,
      "after": [
        "story.realtor_tour"
      ],
      "effects": [
        {
          "setFlag": "bought.old_bakery"
        },
        {
          "dialogue": "dlg.inside"
        }
      ],
      "when": {
        "flag": "seen.scr.realtor_tour"
      },
      "exclusive": true
    },
    {
      "id": "story.cleanup",
      "act": 1,
      "after": [
        "story.enter_bakery"
      ],
      "goal": {
        "title": "Uma boa faxina",
        "steps": [
          {
            "text": "Tirar essas teias dos cantos.",
            "when": {
              "cleaned": "web"
            },
            "devNote": "Clique na sujeira, com a personagem a até 2 células."
          },
          {
            "text": "Varrer a poeira, os papéis e os cacos.",
            "when": {
              "cleaned": "floor"
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.cleaned"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.meow",
      "act": 0,
      "after": [
        "story.cleanup"
      ],
      "goal": {
        "title": "Esse miado...",
        "steps": [
          {
            "text": "Vem da porta da frente. Vou ver.",
            "when": {
              "flag": "seen.cs.meow_door"
            },
            "devNote": "A porta de dentro (14,3) mostra a cena cs.meow_door em vez de sair."
          }
        ]
      },
      "effects": [
        {
          "shelterCat": "cat.first_stray"
        },
        {
          "setFlag": "has.cat"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.cat_named",
      "act": 0,
      "after": [
        "story.meow"
      ],
      "when": {
        "catNamed": "cat.first_stray"
      },
      "effects": [
        {
          "dialogue": "dlg.cat_named"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.water_and_food",
      "act": 0,
      "after": [
        "story.cat_named"
      ],
      "goal": {
        "title": "Água e comida",
        "steps": [
          {
            "text": "Uma tigela de água para {cat:cat.first_stray}.",
            "when": {
              "placed": "item.water_bowl"
            }
          },
          {
            "text": "Não tenho ração... preciso ir ao mercado.",
            "when": {
              "any": [
                {
                  "owned": "item.cat_food_basic"
                },
                {
                  "owned": "item.cat_food_premium"
                }
              ]
            },
            "devNote": "Mercado: porta na coluna 24 da rua; caixa em (13,9), tecla E."
          },
          {
            "text": "E uma tigela para a ração.",
            "when": {
              "placed": "item.food_bowl"
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.ready_to_feed"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.first_meal",
      "act": 0,
      "after": [
        "story.water_and_food"
      ],
      "goal": {
        "title": "Hora de comer",
        "steps": [
          {
            "text": "Escolher a ração na barra e encher a tigela de {cat:cat.first_stray}.",
            "when": {
              "flag": "fed.cat.first_stray"
            },
            "devNote": "Ração ativa na barra (1 a 8), depois E (ou clique) perto da tigela de ração."
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.first_meal"
        },
        {
          "cutscene": "cs.prologue_end"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.prologue_end",
      "act": 0,
      "after": [
        "story.first_meal"
      ],
      "when": {
        "flag": "seen.cs.prologue_end"
      },
      "effects": [
        {
          "setFlag": "prologue.done"
        },
        {
          "endDay": true
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.cat_falls_ill",
      "act": 1,
      "after": [
        "story.prologue_end"
      ],
      "exclusive": true,
      "start": {
        "all": [
          {
            "day": {
              "gte": 6
            }
          },
          {
            "location": "map.cafe_main"
          }
        ]
      },
      "effects": [
        {
          "makeSick": "cat.first_stray"
        },
        {
          "setFlag": "clinic.open"
        },
        {
          "script": "scr.fernanda_visit"
        }
      ]
    },
    {
      "id": "story.vet_visit",
      "act": 1,
      "after": [
        "story.cat_falls_ill"
      ],
      "exclusive": true,
      "goal": {
        "title": "Gatinho doente",
        "steps": [
          {
            "text": "Levar {cat:cat.first_stray} no colo até a clínica da Fernanda, no fim da rua.",
            "when": {
              "flag": "vet.consulted"
            },
            "devNote": "E perto do gato pega no colo; na clínica, E no balcão da Fernanda abre a consulta."
          },
          {
            "text": "Dar o remédio para {cat:cat.first_stray} uma vez por dia, até acabar a receita.",
            "when": {
              "flag": "vet.cured"
            },
            "devNote": "Remédio ativo na barra e E perto do gato (uma dose por dia)."
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.vet_cured"
        }
      ]
    },
    {
      "id": "story.warm_corner",
      "act": 1,
      "after": [
        "story.prologue_end"
      ],
      "goal": {
        "title": "Um cantinho quente",
        "steps": [
          {
            "text": "Uma caminha macia para {cat:cat.first_stray}.",
            "when": {
              "placed": "item.cat_bed"
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.warm_corner_done"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.coffee_machine",
      "act": 1,
      "after": [
        "story.warm_corner"
      ],
      "exclusive": true,
      "goal": {
        "title": "Uma cafeteira",
        "steps": [
          {
            "text": "Juntar 205 moedas com pedidos da vila (mural do mercado ou celular, tecla P): a cafeteira (180) e um balcão para ela (25).",
            "when": {
              "any": [
                {
                  "money": {
                    "gte": 205
                  }
                },
                {
                  "all": [
                    {
                      "owned": "item.coffee_machine"
                    },
                    {
                      "ownedTag": "bar"
                    }
                  ]
                }
              ]
            }
          },
          {
            "text": "Encomendar um balcão pelo catálogo (C).",
            "when": {
              "ownedTag": "bar"
            }
          },
          {
            "text": "Encomendar a cafeteira pelo catálogo (C).",
            "when": {
              "owned": "item.coffee_machine"
            }
          },
          {
            "text": "Montar o balcão e pôr a cafeteira em cima dele.",
            "when": {
              "placed": "item.coffee_machine"
            },
            "devNote": "Abrir as caixas no salão; a cafeteira só vai em cima de um balcão livre (placeOn: bar)."
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.coffee_ready"
        },
        {
          "script": "scr.neusa_visit"
        },
        {
          "setFlag": "met.old_neighbor"
        },
        {
          "setFlag": "painter.available"
        },
        {
          "addMoney": 50
        }
      ]
    },
    {
      "id": "story.tables",
      "act": 1,
      "after": [
        "story.coffee_machine"
      ],
      "start": {
        "nextDay": "story.coffee_machine"
      },
      "exclusive": true,
      "goal": {
        "title": "Mesas para o salão",
        "steps": [
          {
            "text": "Juntar 120 moedas para duas mesas.",
            "when": {
              "any": [
                {
                  "money": {
                    "gte": 120
                  }
                },
                {
                  "ownedTag": "table",
                  "gte": 2
                }
              ]
            }
          },
          {
            "text": "Encomendar duas mesas pelo catálogo (C).",
            "when": {
              "ownedTag": "table",
              "gte": 2
            }
          }
        ]
      },
      "effects": [],
      "when": {
        "deliveryTag": "table",
        "stage": "door",
        "gte": 2
      }
    },
    {
      "id": "story.gabi_call",
      "act": 1,
      "after": [
        "story.tables"
      ],
      "when": {
        "all": [
          {
            "clock": {
              "gte": "07:15"
            }
          },
          {
            "not": {
              "clock": {
                "gte": "19:00"
              }
            }
          }
        ]
      },
      "effects": [
        {
          "cutscene": "cs.gabi_call"
        },
        {
          "startTimer": "gabi.arrival",
          "minutes": 90
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.gabi_visit",
      "act": 1,
      "after": [
        "story.gabi_call"
      ],
      "goal": {
        "title": "A visita da Gabi",
        "steps": [
          {
            "text": "A Gabi chega às {timer:gabi.arrival}.",
            "when": {
              "timer": "gabi.arrival"
            }
          }
        ]
      },
      "effects": [
        {
          "script": "scr.gabi_visit"
        }
      ],
      "exclusive": true
    },
    {
      "id": "story.chairs",
      "act": 1,
      "after": [
        "story.gabi_visit"
      ],
      "exclusive": true,
      "goal": {
        "title": "Cadeiras",
        "steps": [
          {
            "text": "Encomendar duas cadeiras para as mesas.",
            "when": {
              "ownedTag": "chair",
              "gte": 2
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.chairs_done"
        }
      ],
      "start": {
        "flag": "seen.scr.gabi_visit"
      }
    },
    {
      "id": "story.first_customer",
      "act": 1,
      "after": [
        "story.chairs"
      ],
      "exclusive": true,
      "start": {
        "all": [
          {
            "placed": "item.coffee_machine"
          },
          {
            "placedTag": "table"
          },
          {
            "placedTag": "chair"
          }
        ]
      },
      "goal": {
        "title": "O primeiro cliente",
        "steps": [
          {
            "text": "Um balcão para servir em pé.",
            "when": {
              "placedTag": "bar"
            }
          },
          {
            "text": "Montar o cardápio no quadro (tecla M).",
            "when": {
              "menu": {
                "gte": 1
              }
            }
          },
          {
            "text": "Atender o primeiro cliente: preparar, entregar e lavar a louça.",
            "when": {
              "served": {
                "gte": 1
              }
            }
          }
        ]
      },
      "effects": [
        {
          "dialogue": "dlg.first_customer_done"
        },
        {
          "setFlag": "cafe.open"
        }
      ]
    },
    {
      "id": "story.back_room",
      "act": 2,
      "after": [
        "story.inauguration"
      ],
      "start": {
        "room": "room.back_room",
        "atLeast": "discovered"
      },
      "goal": {
        "title": "O quartinho dos fundos",
        "steps": [
          {
            "text": "Pagar a obra para abrir a passagem (catálogo, Obras).",
            "when": {
              "room": "room.back_room",
              "atLeast": "abandoned"
            }
          },
          {
            "text": "Limpar o quartinho.",
            "when": {
              "cleaned": "back_room"
            }
          },
          {
            "text": "Terminar a reforma (catálogo, Obras).",
            "when": {
              "room": "room.back_room",
              "atLeast": "restored"
            }
          }
        ]
      },
      "effects": []
    },
    {
      "id": "story.backyard",
      "act": 2,
      "after": [
        "story.inauguration"
      ],
      "start": {
        "room": "room.backyard",
        "atLeast": "discovered"
      },
      "goal": {
        "title": "O quintal secreto",
        "steps": [
          {
            "text": "Achar a chave do cadeado.",
            "when": {
              "any": [
                {
                  "received": "item.key_backyard"
                },
                {
                  "room": "room.backyard",
                  "atLeast": "abandoned"
                }
              ]
            }
          },
          {
            "text": "Abrir a porta com a chave (E na porta).",
            "when": {
              "room": "room.backyard",
              "atLeast": "abandoned"
            }
          },
          {
            "text": "Limpar o quintal (folhas e mato).",
            "when": {
              "cleaned": "backyard"
            }
          },
          {
            "text": "Terminar a reforma (catálogo, Obras).",
            "when": {
              "room": "room.backyard",
              "atLeast": "restored"
            }
          }
        ]
      },
      "effects": []
    },
    {
      "id": "story.inauguration",
      "act": 2,
      "after": [
        "story.first_customer"
      ],
      "exclusive": true,
      "goal": {
        "title": "A inauguração",
        "steps": [
          {
            "text": "Reformar o café inteiro com o pintor: papel de parede, lambri, os dois pisos e a fachada.",
            "when": {
              "renovated": true
            },
            "devNote": "Superfícies em data/business.json (requiredSurfaces). O pintor está no catálogo (C)."
          },
          {
            "text": "Encomendar a placa do café (catálogo) e abrir a caixa.",
            "when": {
              "received": "item.cafe_sign"
            }
          },
          {
            "text": "Esperar a primavera para inaugurar (faltam {daysUntil:spring} dias).",
            "when": {
              "fromSeason": "spring"
            }
          }
        ]
      },
      "effects": [
        {
          "setBusiness": "inaugurated"
        },
        {
          "setFlag": "cafe.inaugurated"
        },
        {
          "cutscene": "cs.inauguration"
        },
        {
          "dialogue": "dlg.inauguration"
        }
      ]
    }
  ]
}
